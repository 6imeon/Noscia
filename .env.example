# Copy to .env (gitignored) and fill in. Never commit .env.
# Read in app code only via get_secret() in server/src/noscia/config.py.

# BYOK reasoning provider. OpenRouter is the default: one key reaches every model,
# so the demo needs exactly this one secret. Other providers are optional.
OPENROUTER_API_KEY=

# Postgres (ParadeDB) — matches docker-compose.yml. Note the +psycopg driver.
DATABASE_URL=postgresql+psycopg://noscia:noscia@localhost:5432/noscia
